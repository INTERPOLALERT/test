# KimiGPT - API Configuration
# Copy this file to .env and add your actual API keys

# =================================================================
# PRIMARY AI APIs - 100% FREE! No trials, no credits, no payments!
# =================================================================

# Groq API (Fastest, most generous free tier - 14,400 req/day!)
# Get key: https://console.groq.com/
GROQ_API_KEY=gsk_your-key-here

# Google Gemini API (Great multi-modal support - 60 req/min free!)
# Get key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-your-key-here

# Hugging Face API (Free inference API - unlimited!)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your-token-here

# Cohere API (Free tier - 100 req/min!)
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-key-here

# =================================================================
# APPLICATION SETTINGS
# =================================================================

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=your-secret-key-change-in-production

# Preview Server
PREVIEW_PORT=3000

# Database
DATABASE_URL=sqlite:///database/kimigpt.db

# File Upload Settings
MAX_UPLOAD_SIZE=50  # MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,svg,mp4,webm,mov,mp3,wav,ogg,pdf,docx,txt

# API Settings
API_TIMEOUT=30  # seconds
API_RETRY_ATTEMPTS=3
API_CACHE_ENABLED=true
API_CACHE_TTL=3600  # seconds

# Generation Settings
DEFAULT_FRAMEWORK=vanilla  # vanilla, react, vue, nextjs
DEFAULT_CSS_FRAMEWORK=vanilla  # vanilla, tailwind, bootstrap
DEFAULT_COMPLEXITY=moderate  # simple, moderate, advanced
AUTO_SAVE_INTERVAL=30  # seconds

# Security
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=30
ENABLE_FILE_SCANNING=true

# Deployment
ENABLE_GITHUB_INTEGRATION=true
ENABLE_NETLIFY_DEPLOYMENT=true
ENABLE_VERCEL_DEPLOYMENT=true
